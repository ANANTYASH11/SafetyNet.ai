# ─────────────────────────────────────────────────────────────
# SafetyNet.ai — AI Emergency Fund Calculator  |  .env.example
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5001
NODE_ENV=development
LOG_LEVEL=debug

# MongoDB (optional — app uses file-based storage as fallback)
# Get a free cluster at https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/safetynet?retryWrites=true&w=majority

# Groq AI API (optional — app uses rule-based insights as fallback)
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant

# CORS (comma-separated origins; default: allow all)
CLIENT_ORIGIN=http://localhost:5173
